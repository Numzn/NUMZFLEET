# NumzTrak Fleet Management System - Environment Template
# Copy this file to backend/.env and update with your actual values.
# DO NOT commit .env to version control!
#
# This is the single canonical env template (env.template was merged into it).
# Both compose stacks (root docker-compose.yml and deployment/compose/
# docker-compose.prod.yml) load backend/.env via env_file.

# ===========================================
# DATABASES
# ===========================================

# MySQL (Traccar database — the traccar-mysql container reads these directly).
# MYSQL_PASSWORD must match backend/conf/traccar.xml <entry key='database.password'>.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=traccar
MYSQL_USER=traccar
MYSQL_PASSWORD=CHANGE_ME_STRONG_TRACCAR_DB_PASSWORD

# PostgreSQL (Fuel API database)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Optional: explicit URL for fuel-api. If unset, fuel-api builds one from POSTGRES_PASSWORD
# (user=numztrak, host=db, port=5432, db=numztrak_fuel) — same contract as registry prod compose.
# DATABASE_URL=postgresql://numztrak:CHANGE_ME@db:5432/numztrak_fuel

# ===========================================
# APPLICATION
# ===========================================

# Dev default. Production (deployment/compose/docker-compose.prod.yml): NODE_ENV=production.
NODE_ENV=development
PORT=3000
# Dev origins shown; production example:
# CORS_ORIGIN=https://numz.site,https://app.numz.site
CORS_ORIGIN=http://localhost:5174,http://localhost:3002
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET

# fuel-api (docker-compose.yml): default FUEL_API_NODE_ENV=development so permissive auth does not call process.exit(1).
# Production (deployment/compose/docker-compose.prod.yml): strict auth; POSTGRES_PASSWORD
# is enough for fuel-api DB URL unless you set DATABASE_URL above.
#   FUEL_API_NODE_ENV=production
#   AUTH_STRATEGY=strict
#   TRACCAR_ENABLED=true
# See deployment/REGISTRY_DEPLOY.md
FUEL_API_NODE_ENV=development
AUTH_STRATEGY=permissive
TRACCAR_ENABLED=true

# Traccar HTTP service account (fuel-api — immobilization + Routine Service schedule sync).
# Set real values here or in project root .env; docker-compose passes TRACCAR_API_* into backend
# and overrides placeholder values in this file when root .env is present.
TRACCAR_SERVER_URL=http://traccar:8082
TRACCAR_API_USER=admin@example.com
TRACCAR_API_PASSWORD=change-me

# ===========================================
# ERB FUEL MONITOR
# ===========================================

# Shared secret between fuel-api and erb-api.
# fuel-api sends Authorization: Bearer <token> to erb-api /v1/prices/latest
# erb-api accepts API_TOKEN or ERB_API_TOKEN (same value — set at least one of each name to the same secret)
ERB_API_BASE_URL=http://erb-api:8000
ERB_API_TOKEN=replace-with-long-random-token
API_TOKEN=replace-with-long-random-token
# Dev origin shown; production: https://numz.site
ERB_API_ALLOWED_ORIGINS=http://localhost:3002

# ERB worker email notifications (compose maps ERB_EMAIL_* → the worker's EMAIL_* vars)
ERB_EMAIL_ENABLED=false
ERB_EMAIL_FROM=CHANGE_ME_EMAIL_SENDER
ERB_EMAIL_PASSWORD=CHANGE_ME_EMAIL_APP_PASSWORD
ERB_EMAIL_TO=CHANGE_ME_EMAIL_RECIPIENT
ERB_SMTP_SERVER=smtp.gmail.com
ERB_SMTP_PORT=587
ERB_SSL_VERIFY=true
ERB_SSL_ALLOW_INSECURE_FALLBACK=true

# Optional ERB S3 persistence
ERB_S3_ENABLED=false
ERB_S3_BUCKET=
ERB_S3_KEY=fuel_prices.json

# ===========================================
# DOCUMENT OCR
# ===========================================

# Document OCR (Python) — fuel-api calls document-ocr /v1/extract
# document-ocr validates Bearer token using DOCUMENT_OCR_TOKEN or API_TOKEN (must match fuel-api)
DOCUMENT_OCR_BASE_URL=http://document-ocr:8010
DOCUMENT_OCR_TOKEN=
DOCUMENT_OCR_ON_UPLOAD=1

# ===========================================
# SMS GATEWAY
# ===========================================

# NUMZ SMS Gateway (infrastructure/sms-gateway on NumzLab) — Dev-only path.
# fuel-api and the gateway are separate Docker networks on the same host, so
# SMS_GATEWAY_BASE_URL must be the discovered Docker bridge gateway IP
# (`docker network inspect bridge`), not a container name or 127.0.0.1.
# HTTP Basic Auth (not Bearer). Do NOT set these for OCI/production yet.
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TIMEOUT_MS=10000

# Phase 6: provider delivery-status webhook (routes/providerWebhooks.js).
# Shared secret the gateway must send back as x-sms-gateway-webhook-secret —
# choose one and configure it into the gateway's own webhook registration
# (POST /api/3rdparty/v1/webhooks) when actually registering it; the route
# fails closed (503) until this is set. Not yet registered with the live
# gateway as of Phase 6 — see the Phase 6 report.
SMS_GATEWAY_WEBHOOK_SECRET=

# Phase 6: bounded reconciliation sweep for SMS deliveries stuck at 'sent'
# (jobs/smsDeliveryReconciliationScheduler.js) — the safety net alongside the
# webhook above, not a replacement for it. Only runs when the SMS gateway
# itself is configured. Defaults shown; override only if you have a specific
# reason to.
# SMS_DELIVERY_RECONCILIATION=1
# SMS_RECONCILIATION_POLL_MS=300000
# SMS_RECONCILIATION_STALE_AFTER_MS=900000
# SMS_RECONCILIATION_BATCH=20
# SMS_RECONCILIATION_STARTUP_MS=60000

# Phase 7: automatic escalation (jobs/notificationEscalationScheduler.js) —
# re-notifies mandatory, immediate-urgency notifications nobody has
# acknowledged after NOTIFICATION_ESCALATION_AFTER_MS, via every channel,
# once. Not SMS-specific (channel-agnostic), grouped here only because it
# follows the same scheduler shape. Defaults shown; override only if you have
# a specific reason to.
# NOTIFICATION_ESCALATION_ENABLED=1
# NOTIFICATION_ESCALATION_AFTER_MS=600000
# NOTIFICATION_ESCALATION_POLL_MS=60000
# NOTIFICATION_ESCALATION_BATCH=20
# NOTIFICATION_ESCALATION_STARTUP_MS=30000

# ===========================================
# EMAIL (fuel-api notification channel)
# ===========================================

# fuel-api's own product-notification email channel (compliance/maintenance
# alerts, gated per-user by Settings > Notifications). Separate from, and
# NOT to be confused with, the unrelated ERB_EMAIL_* block above — that one
# belongs to the fuel-price scraper's own ops alerts, not this.
#
# EMAIL_PROVIDER selects the transport; only 'smtp' is implemented today.
# For Gmail: use an App Password (not your normal password), smtp.gmail.com,
# port 587, EMAIL_SECURE=false (STARTTLS) — matches the pattern already used
# by ERB_SMTP_SERVER above, but this is a fully separate credential.
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TIMEOUT_MS=10000

# ===========================================
# TRACCAR NATIVE SMTP (separate from fuel-api EMAIL_* above)
# ===========================================

# Traccar's own native mailer (org.traccar.mail.SmtpMailManager) — powers
# the native Notifications page's "Mail" notificator and system messages
# (e.g. password reset). Rendered into traccar.xml.template's placeholders
# by backend/conf/traccar-entrypoint.sh. Can be the same Gmail account as
# EMAIL_* above, but kept as separate variables on purpose — two different
# systems, never conflate them.
TRACCAR_MAIL_SMTP_USERNAME=
TRACCAR_MAIL_SMTP_PASSWORD=

# ===========================================
# WEB PUSH (fuel-api notification channel)
# ===========================================

# Standard Web Push + VAPID (web-push npm package) — powers pushChannel.js,
# gated per-user/per-category the same way EMAIL_* above is. Generate a
# keypair once with `npx web-push generate-vapid-keys` and never rotate it
# casually — every already-registered browser subscription is tied to the
# public key it subscribed with; rotating invalidates all of them.
# VAPID_SUBJECT must be a mailto: address or an https: URL identifying who
# is sending — required by the spec, some push services reject requests
# without it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info.numztech@gmail.com

# ===========================================
# BACKGROUND JOBS
# ===========================================

# Immobilization intent evaluator tick (fuel-api). Default 2000ms; set 0 to disable.
# IMMOBILIZATION_EVALUATOR_INTERVAL_MS=2000
# IMMOBILIZATION_EVALUATOR_STARTUP_DELAY_MS=5000
# EXECUTION_CLAIM_TIMEOUT_SEC=45
# IMMOBILIZATION_RECONCILE_ON_STARTUP=1
# IMMOBILIZATION_USE_ADVISORY_LOCK=1
# IMMOBILIZATION_ACK_PROBE=1
# IMMOBILIZATION_ACK_PROBE_WINDOW_SEC=900

# Tracking notification bridge (poll Traccar tc_events → PostgreSQL notifications)
# Required for geofence/overspeed bell rows (PR1). Safe to re-run SQL migrations before enabling.
TRACKING_NOTIFICATION_BRIDGE=1
TRACKING_BRIDGE_POLL_MS=15000
# TRACKING_BRIDGE_BATCH_SIZE=100
# TRACKING_BRIDGE_LOOKBACK_HOURS=48

# Compliance + maintenance notification schedulers — proactive, scheduler-driven
# checks so a vehicle nobody opens still gets notified (not page-view-triggered).
COMPLIANCE_NOTIFICATION_SCHEDULER=1
# COMPLIANCE_NOTIFICATION_POLL_MS=600000
MAINTENANCE_NOTIFICATION_SCHEDULER=1
# MAINTENANCE_NOTIFICATION_POLL_MS=600000

# Fleet-state alerts (extended offline, GPS loss/recovery, excessive idle) —
# piggybacks on the existing vehicle-state reconciliation sweep (15-min interval).
# Off by default, same as the schedulers above.
# VEHICLE_STATE_ALERTS_ENABLED=1
# VEHICLE_EXTENDED_OFFLINE_THRESHOLD_MS=7200000
# VEHICLE_EXCESSIVE_IDLE_THRESHOLD_MS=2700000

# Non-routine maintenance risk + vehicle-health/fuel-efficiency intelligence
# notifications (wired from the existing vehicle-intelligence read model).
# CAUTION: this makes getVehicleEngine() open a real Traccar MySQL pool —
# fine in the long-running server, but a `node --test` process that opens it
# for the first time via this path can hang past test completion waiting for
# that pool's sockets to settle (confirmed on vehicleEngineService.test.js).
# Leave off when running the test suite in the same environment as this file.
# INTELLIGENCE_NOTIFICATIONS_ENABLED=1

# Fuel anomaly notifications (tank-capacity-exceeded flag, already computed
# live on every refuel completion). Off by default, same reasoning as above.
# FUEL_ANOMALY_NOTIFICATIONS_ENABLED=1

# ===========================================
# FRONTEND DEV
# ===========================================

# Vite HMR (Hot Module Replacement) - Frontend Development
VITE_HMR_EXTERNAL=
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5174

# GPS protocol ports are defined in backend/conf/traccar.xml and published on the
# host in deployment/compose/docker-compose.prod.yml (prod). Keep OCI ingress aligned
# with only the ports you use. Baseline keys: 5001–5006, 5009, 5013, 5020, 5055.
